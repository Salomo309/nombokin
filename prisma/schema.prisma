// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  MEMBER
  ADMIN
}

enum InvoiceType {
  INVOICE
  QUOTATION
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  EXPIRED
  CANCELLED
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum WebhookProvider {
  MIDTRANS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  CANCELLED
  FAILED
}

enum PaymentType {
  SUBSCRIPTION
  INVOICE
}

// ============================================================
// MODELS
// ============================================================

model Tenant {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  logoUrl              String?
  letterheadSignature  String?
  watermarkText        String   @default("Dibuat dengan Nombokin")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  users         User[]
  customers     Customer[]
  invoices      Invoice[]
  products      Product[]
  subscription  Subscription?
  payments      Payment[]

  @@index([slug])
}

model User {
  id                        String    @id @default(cuid())
  tenantId                  String
  email                     String    @unique
  name                      String
  passwordHash              String?
  role                      UserRole  @default(MEMBER)
  googleId                  String?   @unique
  refreshToken              String?
  emailVerifiedAt           DateTime?
  verificationToken         String?   @unique
  verificationTokenExpiresAt DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments Payment[]

  @@index([tenantId])
  @@index([email])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  company   String?
  email     String?
  whatsapp  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  customerId        String?
  number            String
  type              InvoiceType   @default(INVOICE)
  status            InvoiceStatus @default(DRAFT)
  issueDate         DateTime
  dueDate           DateTime
  subtotal          Decimal       @db.Decimal(15, 2)
  discountPercent   Decimal       @db.Decimal(5, 2) @default(0)
  taxPercent        Decimal       @db.Decimal(5, 2) @default(0)
  total             Decimal       @db.Decimal(15, 2)
  currency          String        @default("IDR")
  notes             String?
  terms             String?
  shareToken        String        @unique
  midtransOrderId   String?       @unique
  midtransPaymentUrl String?
  paidAt            DateTime?
  isDeleted         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([shareToken])
  @@index([status])
  @@index([tenantId, type])
  @@index([dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  qty         Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Product {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  unitPrice   Decimal  @db.Decimal(15, 2)
  currency    String   @default("IDR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Subscription {
  id                      String             @id @default(cuid())
  tenantId                String             @unique
  tier                    SubscriptionTier   @default(FREE)
  status                  SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd        DateTime?
  midtransSubscriptionId  String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WebhookEvent {
  id          String          @id @default(cuid())
  provider    WebhookProvider
  eventId     String          @unique
  payload     Json
  processedAt DateTime        @default(now())

  @@index([provider, eventId])
}

model Payment {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String?
  invoiceId     String?
  orderId       String            @unique
  type          PaymentType       @default(SUBSCRIPTION)
  status        PaymentStatus     @default(PENDING)
  amount        Decimal           @db.Decimal(15, 2)
  tier          SubscriptionTier?
  interval      String?
  transactionId String?
  paymentMethod String?
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
